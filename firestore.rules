rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId) || isAdmin();
    }

    // ─── Vans ──────────────────────────────────────────────────────────────
    match /vans/{vanId} {
      // Only owner or admin can read a specific van's details (no public listing)
      allow read: if isSignedIn()
                  && (resource.data.driverId == request.auth.uid || isAdmin());
      // Anyone signed in can list vans (for matching) — enforced in app logic
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.driverId == request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.driverId == request.auth.uid || isAdmin())
                    && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isSignedIn()
                    && resource.data.driverId == request.auth.uid;
    }

    // ─── Bookings ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Read: renter (own bookings), driver (own accepted bookings),
      //       any PENDING booking (the public pool for drivers to browse),
      //       or admin.
      // This fixes the silent fail where drivers couldn't see the public pool:
      // pending bookings have no driverId yet (set only when a driver accepts).
      allow read: if isSignedIn() && (
                      resource.data.renterId == request.auth.uid
                      || resource.data.driverId == request.auth.uid
                      || resource.data.status == 'pending'
                      || isAdmin()
                  );

      // Create: any signed-in user can create a booking as renter
      allow create: if isSignedIn()
                    && request.resource.data.renterId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Admin: full access
      allow update, delete: if isAdmin();

      // Renter: can cancel their own pending/confirmed booking
      allow update: if isSignedIn()
                    && resource.data.renterId == request.auth.uid
                    && request.resource.data.status == 'cancelled'
                    && resource.data.status in ['pending', 'confirmed'];

      // Driver accepting a pending booking: driverId is currently absent
      // (pending bookings have no driver assigned yet), the update sets
      // driverId to the accepting driver's uid and status → 'confirmed'.
      // Using 'in' check since 'driverId' is absent, not null.
      allow update: if isSignedIn()
                    && resource.data.status == 'pending'
                    && !('driverId' in resource.data)
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.driverId == request.auth.uid;

      // Driver progressing their accepted booking: confirmed → in_progress → completed
      allow update: if isSignedIn()
                    && resource.data.driverId == request.auth.uid
                    && resource.data.status in ['in_progress', 'completed']
                    && resource.data.status in ['confirmed', 'in_progress'];

      // ─── Phase 8: Chat messages sub-collection ─────────────────────────
      match /messages/{messageId} {
        // Read: renter + assigned driver + admin only
        allow read: if isSignedIn() && (
                        get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid
                        || get(/databases/$(database)/documents/bookings/$(bookingId)).data.driverId == request.auth.uid
                        || isAdmin()
                    );

        // Create: party posts under own role, booking must be confirmed/in_progress
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.senderRole in ['renter', 'driver']
                      && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status in ['confirmed', 'in_progress']
                      && (
                        (request.resource.data.senderRole == 'renter'
                         && get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid)
                        ||
                        (request.resource.data.senderRole == 'driver'
                         && get(/databases/$(database)/documents/bookings/$(bookingId)).data.driverId == request.auth.uid)
                      )
                      && request.resource.data.keys().hasAll(['senderId', 'senderRole', 'createdAt'])
                      && request.resource.data.text.size() <= 2000
                      && (!('images' in request.resource.data) || request.resource.data.images.size() <= 3);

        // No client update/delete — messages are immutable for audit
        allow update, delete: if false;
      }

      // ─── Phase 8: readState update (renter/driver marks own chat read) ──
      // Only allows touching the readState field. Other fields untouched.
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readState'])
                    && (
                      resource.data.renterId == request.auth.uid
                      || resource.data.driverId == request.auth.uid
                    );
    }

    // ─── Config ────────────────────────────────────────────────────────────
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────
    // Notifications are system-triggered: e.g. when a driver accepts a
    // booking, the driver's session calls notifyBookingAccepted(renterId, ...)
    // which creates a notification FOR the renter. The acting user's uid is
    // the sender (driver), not the recipient (renter), so the create rule
    // can't require request.auth.uid == resource.data.userId.
    // For v1 we allow any signed-in user to create a notification for any
    // userId. In production this should move to a Cloud Function trigger
    // for stronger guarantees.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId is string;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── Drivers (online/offline state + location tracking) ──────────────────
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (request.auth.uid == driverId || isAdmin());
      // Tighten create to a known shape — protects against a compromised
      // client writing arbitrary fields to drivers/{theirUid}.
      allow create: if isSignedIn()
                    && request.auth.uid == driverId
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'driverId', 'isOnline', 'currentVanId',
                      'vehicleType', 'updatedAt'
                    ]);
      // Updates may only modify documented driver-state fields.
      allow update: if isSignedIn()
                    && request.auth.uid == driverId
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly([
                          'isOnline', 'currentVanId', 'vehicleType',
                          'currentLat', 'currentLng', 'updatedAt'
                        ]);
      allow delete: if isSignedIn() && request.auth.uid == driverId;
    }
  }
}