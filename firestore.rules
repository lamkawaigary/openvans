rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId) || isAdmin();
    }

    // ─── Vans ──────────────────────────────────────────────────────────────
    match /vans/{vanId} {
      // Only owner or admin can read a specific van's details (no public listing)
      allow read: if isSignedIn()
                  && (resource.data.ownerId == request.auth.uid || isAdmin());
      // Anyone signed in can list vans (for matching) — enforced in app logic
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid || isAdmin())
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    // ─── Bookings ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Read: renter (own bookings), owner (own bookings), or admin (all)
      allow read: if isSignedIn()
                  && (resource.data.renterId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid
                      || isAdmin());

      // Create: any signed-in user can create a booking as renter
      allow create: if isSignedIn()
                    && request.resource.data.renterId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Admin: full access
      allow update, delete: if isAdmin();

      // Renter: can cancel their own pending/confirmed booking
      allow update: if isSignedIn()
                    && resource.data.renterId == request.auth.uid
                    && request.resource.data.status == 'cancelled'
                    && resource.data.status in ['pending', 'confirmed'];

      // Owner: can accept pending bookings assigned to them
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'confirmed'
                    && resource.data.status == 'pending';

      // Owner: can advance confirmed → in_progress → completed
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.status in ['in_progress', 'completed']
                    && resource.data.status in ['confirmed', 'in_progress'];
    }

    // ─── Config ────────────────────────────────────────────────────────────
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── Drivers (online/offline state + location tracking) ──────────────────
    match /drivers/{ownerId} {
      allow read: if isSignedIn() && (request.auth.uid == ownerId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == ownerId;
      allow delete: if isSignedIn() && request.auth.uid == ownerId;
    }
  }
}