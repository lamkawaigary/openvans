rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Van photos: owners can upload, anyone can read
    match /vans/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // User avatars: users can upload their own, anyone can read
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024  // max 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ─── Phase 8: Chat images (Phase 8) ─────────────────────────────────────
    // Path: bookings/{bookingId}/messages/{messageId}/{idx}.jpg
    // Read/write restricted to the renter + assigned driver of that booking.
    match /bookings/{bookingId}/messages/{messageId}/{fileName} {
      allow read: if request.auth != null && (
        firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid
        || firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.driverId == request.auth.uid
      );

      allow write: if request.auth != null
        && request.resource.size <= 1 * 1024 * 1024  // max 1MB safety (post-compression target 500KB)
        && request.resource.contentType.matches('image/.*')
        && (
          firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid
          || firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.driverId == request.auth.uid
        );

      // No client delete — Cloud Function cron handles 7-day cleanup
      allow delete: if false;
    }
  }
}
